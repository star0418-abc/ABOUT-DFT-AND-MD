; ==============================================================================
; em.mdp - Energy Minimization (能量最小化) - 生产版
; ==============================================================================
; 用途: 消除初始结构中的高能构象、原子重叠和不合理键长
; 版本: Production v1.0
; 适用: 聚合物/凝胶电解质体系
;
; 与 smoke 版本的区别:
;   - 更严格的收敛标准 (emtol=500)
;   - 更多的最大迭代步数 (nsteps=100000)
;   - 更小的初始步长 (emstep=0.005)
;
; 典型运行时间: 数分钟~数十分钟 (取决于体系大小和初始构型)
; ==============================================================================

; ============== 积分器设置 ==============
integrator      = steep         ; 最速下降法 (Steepest Descent)
emtol           = 500.0         ; 最大力收敛标准 (kJ/mol/nm)
                                ; 500 比 smoke 的 1000 更严格
emstep          = 0.005         ; 初始步长 (nm)，较小更稳定
nsteps          = 100000        ; 最大迭代步数 (足够大以确保收敛)

; ============== 输出控制 ==============
nstxout         = 0             ; 不输出未压缩坐标 (节省空间)
nstvout         = 0             ; 不输出速度
nstfout         = 0             ; 不输出力
nstenergy       = 500           ; 能量输出频率 (步)
nstlog          = 500           ; 日志输出频率 (步)
nstxout-compressed = 0          ; EM 阶段不需要轨迹

; ============== 近邻列表 ==============
cutoff-scheme   = Verlet        ; Verlet 缓冲区方案 (GROMACS 2021+ 强制)
nstlist         = 10            ; 邻居列表更新频率
pbc             = xyz           ; 三维周期性边界条件

; ============== 静电相互作用 (PME) ==============
coulombtype     = PME           ; Particle Mesh Ewald
rcoulomb        = 1.2           ; 实空间截断距离 (nm)
fourierspacing  = 0.12          ; FFT 网格间距 (nm)
pme-order       = 4             ; PME 插值阶数

; ============== 范德华相互作用 ==============
vdwtype         = Cut-off       ; 截断型 vdW
vdw-modifier    = Potential-shift  ; 平滑截断
rvdw            = 1.2           ; vdW 截断距离 (nm)
DispCorr        = EnerPres      ; 长程色散校正 (能量+压力)

; ============== 约束 ==============
constraints     = none          ; EM 阶段不使用约束 (让所有自由度松弛)

; ============== 质心运动移除 ==============
nstcomm         = 100           ; 质心运动移除频率
comm-mode       = Linear        ; 移除平动

