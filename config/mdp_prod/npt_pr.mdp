; ==============================================================================
; npt_pr.mdp - NPT Strict Equilibration with Parrinello-Rahman - 生产版
; ==============================================================================
; 用途: 使用 Parrinello-Rahman 压控进行严格 NPT 平衡
;       作为进入生产段 (md_prod) 前的最终平衡阶段
; 版本: Production v1.0
; 适用: 聚合物/凝胶电解质体系
;
; 说明:
;   Parrinello-Rahman 产生正确的 NPT 系综，适合正式统计
;   但 P-R 对初始构型敏感，需先用 Berendsen 预平衡
;
; 典型流程: em → nvt → npt_ber → npt_pr → md_prod
;
; 默认时长: 5 ns (2,500,000 步 × 2 fs)
; 默认温度: 298 K
; 默认压力: 1.0 bar
;
; 与 smoke 版本的区别:
;   - 更长的平衡时间 (5 ns vs 1 ns)
;   - 更大的压力耦合时间常数 (tau_p=5.0)
;   - 与 md_prod 参数完全一致，确保平滑过渡
;
; 修改时长: 改 nsteps 即可
;   - 2 ns  = 1000000 步
;   - 5 ns  = 2500000 步
;   - 10 ns = 5000000 步
; ==============================================================================

; ============== 运行控制 ==============
integrator      = md            ; 分子动力学
dt              = 0.002         ; 时间步长 2 fs
nsteps          = 2500000       ; 5 ns (2500000 × 2 fs)

; ============== 输出控制 ==============
nstxout         = 0             ; 不输出未压缩坐标
nstvout         = 0             ; 不输出速度
nstfout         = 0             ; 不输出力
nstxout-compressed = 5000       ; 压缩轨迹每 10 ps
nstenergy       = 500           ; 能量每 1 ps
nstlog          = 500           ; 日志每 1 ps
nstcalcenergy   = 100           ; 能量计算频率

; ============== 近邻列表 ==============
cutoff-scheme   = Verlet
nstlist         = 20
pbc             = xyz
verlet-buffer-tolerance = 0.005

; ============== 静电相互作用 (PME) ==============
coulombtype     = PME
rcoulomb        = 1.2
fourierspacing  = 0.12
pme-order       = 4

; ============== 范德华相互作用 ==============
vdwtype         = Cut-off
vdw-modifier    = Potential-shift
rvdw            = 1.2
DispCorr        = EnerPres

; ============== 温度耦合 ==============
tcoupl          = V-rescale     ; 速度重标定
                                ; V-rescale 生产更稳定
                                ; 可选: Nose-Hoover (更严格正则系综，但可能振荡)
tc-grps         = System
tau_t           = 0.5           ; 时间常数 (ps)
                                ; 平衡/生产阶段用较大值 (0.5-2.0)
ref_t           = 298           ; 目标温度 (K)

; ============== 压力耦合 - Parrinello-Rahman ==============
; Parrinello-Rahman 产生正确的 NPT 系综
pcoupl          = Parrinello-Rahman
pcoupltype      = isotropic     ; 各向同性
                                ; 可选: semiisotropic (膜体系)
                                ; 可选: anisotropic (晶体)
tau_p           = 5.0           ; 压力耦合时间常数 (ps)
                                ; P-R 建议 5-10 ps，避免振荡
ref_p           = 1.0           ; 目标压力 (bar)
compressibility = 4.5e-5        ; 等温压缩系数 (bar^-1)
                                ; 水/有机溶剂: 4.5e-5
                                ; 聚合物固体: 可调小 (如 1e-5 ~ 2e-5)

; ============== 初始速度 ==============
gen_vel         = no            ; 从前一步继续
continuation    = yes           ; 续算模式

; ============== 约束 ==============
constraints     = h-bonds
constraint-algorithm = LINCS
lincs-iter      = 1
lincs-order     = 4

; ============== 质心运动移除 ==============
nstcomm         = 100
comm-mode       = Linear
comm-grps       = System

