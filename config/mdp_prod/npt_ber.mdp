; ==============================================================================
; npt_ber.mdp - NPT Pre-equilibration with Berendsen (预平衡) - 生产版
; ==============================================================================
; 用途: 使用 Berendsen 压控快速收敛密度和盒子尺寸
; 版本: Production v1.0
; 适用: 聚合物/凝胶电解质体系
;
; ⚠️ 重要警告:
;   Berendsen 压控不产生正确的 NPT 系综！
;   仅用于预平衡阶段快速收敛密度，不可用于正式采样统计！
;   正式采样必须使用 Parrinello-Rahman (npt_pr.mdp 或 md_prod.mdp)
;
; 默认时长: 2 ns (1,000,000 步 × 2 fs)
; 默认温度: 298 K
; 默认压力: 1.0 bar
;
; 与 smoke 版本的区别:
;   - 更长的预平衡时间 (2 ns vs 200 ps)
;   - 更合理的压力耦合时间常数 (tau_p=2.0)
;   - 明确标注"仅用于预平衡"
;
; 修改时长: 改 nsteps 即可
;   - 1 ns  = 500000 步
;   - 2 ns  = 1000000 步
;   - 5 ns  = 2500000 步
; ==============================================================================

; ============== 运行控制 ==============
integrator      = md            ; 分子动力学
dt              = 0.002         ; 时间步长 2 fs
nsteps          = 1000000       ; 2 ns (1000000 × 2 fs)

; ============== 输出控制 ==============
nstxout         = 0             ; 不输出未压缩坐标
nstvout         = 0             ; 不输出速度
nstfout         = 0             ; 不输出力
nstxout-compressed = 5000       ; 压缩轨迹每 10 ps
nstenergy       = 500           ; 能量每 1 ps
nstlog          = 500           ; 日志每 1 ps
nstcalcenergy   = 100           ; 能量计算频率

; ============== 近邻列表 ==============
cutoff-scheme   = Verlet
nstlist         = 20
pbc             = xyz
verlet-buffer-tolerance = 0.005

; ============== 静电相互作用 (PME) ==============
coulombtype     = PME
rcoulomb        = 1.2
fourierspacing  = 0.12
pme-order       = 4

; ============== 范德华相互作用 ==============
vdwtype         = Cut-off
vdw-modifier    = Potential-shift
rvdw            = 1.2
DispCorr        = EnerPres

; ============== 温度耦合 ==============
tcoupl          = V-rescale     ; 速度重标定
tc-grps         = System
tau_t           = 0.1           ; 时间常数 (ps)
ref_t           = 298           ; 目标温度 (K)

; ============== 压力耦合 - Berendsen ==============
; ⚠️ Berendsen 仅用于预平衡！不产生正确的 NPT 系综！
pcoupl          = Berendsen     ; Berendsen 压控 (快速密度收敛)
pcoupltype      = isotropic     ; 各向同性压缩
tau_p           = 2.0           ; 压力耦合时间常数 (ps)
                                ; 2.0 ps 比 smoke 的 1.0 更稳定
ref_p           = 1.0           ; 目标压力 (bar)
compressibility = 4.5e-5        ; 等温压缩系数 (bar^-1)
                                ; 4.5e-5 适用于水/有机溶剂体系
                                ; 聚合物体系可适当减小 (如 1e-5)
refcoord-scaling = com          ; 参考坐标按质心缩放

; ============== 初始速度 ==============
gen_vel         = no            ; 从 NVT 继续，不重新生成速度
continuation    = yes           ; 续算模式

; ============== 约束 ==============
constraints     = h-bonds
constraint-algorithm = LINCS
lincs-iter      = 1
lincs-order     = 4

; ============== 质心运动移除 ==============
nstcomm         = 100
comm-mode       = Linear
comm-grps       = System

