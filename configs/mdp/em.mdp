; ==============================================================================
; em.mdp - Energy Minimization (能量最小化)
; ==============================================================================
; 用途: 消除初始结构中的高能构象和重叠
; 来源: gel_packmol smoke pipeline
; ==============================================================================

; 积分器设置
integrator  = steep     ; 最速下降法
emtol       = 1000.0    ; 最大力收敛标准 (kJ/mol/nm)
emstep      = 0.01      ; 初始步长 (nm)
nsteps      = 50000     ; 最大迭代步数

; 输出控制
nstxout     = 0         ; 不输出坐标轨迹 (节省空间)
nstvout     = 0         ; 不输出速度
nstfout     = 0         ; 不输出力
nstenergy   = 500       ; 能量输出频率
nstlog      = 500       ; 日志输出频率

; 近邻列表
cutoff-scheme   = Verlet
nstlist         = 10
ns_type         = grid
pbc             = xyz
rlist           = 1.2

; 静电相互作用
coulombtype     = PME
rcoulomb        = 1.2
fourierspacing  = 0.12

; 范德华相互作用
vdwtype         = Cut-off
rvdw            = 1.2
DispCorr        = EnerPres  ; 长程色散校正

; 约束
constraints     = none      ; EM 阶段不使用约束

