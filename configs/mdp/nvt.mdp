; ==============================================================================
; nvt.mdp - NVT Equilibration (恒温平衡)
; ==============================================================================
; 用途: 在恒定体积下平衡温度
; 来源: gel_packmol smoke pipeline
; 时长: 100 ps (smoke test，正式模拟建议 500 ps - 1 ns)
; ==============================================================================

; 运行控制
integrator  = md
dt          = 0.001     ; 时间步长 1 fs (保守，适合初始平衡)
nsteps      = 100000    ; 100 ps (smoke); 正式模拟可用 500000

; 输出控制
nstxout         = 0             ; 不输出完整轨迹
nstxout-compressed = 5000       ; 压缩轨迹每 5 ps
nstvout         = 0
nstfout         = 0
nstenergy       = 1000          ; 能量每 1 ps
nstlog          = 1000          ; 日志每 1 ps

; 近邻列表
cutoff-scheme   = Verlet
nstlist         = 20
ns_type         = grid
pbc             = xyz
rlist           = 1.2

; 静电
coulombtype     = PME
rcoulomb        = 1.2
fourierspacing  = 0.12

; 范德华
vdwtype         = Cut-off
rvdw            = 1.2
DispCorr        = EnerPres

; 温度耦合
tcoupl          = V-rescale     ; 速度重标定温控 (推荐用于平衡)
tc-grps         = System        ; 整个体系一个温控组
tau_t           = 0.1           ; 时间常数 (ps)
ref_t           = 300           ; 目标温度 (K)

; 压力耦合 (NVT 阶段关闭)
pcoupl          = no

; 初始速度
gen_vel         = yes           ; 生成初始速度
gen_temp        = 300           ; 初始温度
gen_seed        = -1            ; 随机种子

; 约束
constraints     = h-bonds       ; 约束氢键 (允许更大时间步)
constraint-algorithm = LINCS
lincs-order     = 4

